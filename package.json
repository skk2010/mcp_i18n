{
  "name": "mcp-i18n",
  "version": "0.1.1",
  "description": "MCP server that gives coding agents tools to manage Rails-style YAML/JSON localization files",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "mcp-i18n": "dist/src/index.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "i18n",
    "localization",
    "rails",
    "yaml",
    "translations"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skk2010/mcp_i18n.git"
  },
  "homepage": "https://github.com/skk2010/mcp_i18n#readme",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "smoke": "npm run build && node dist/test/smoke.js",
    "start": "node dist/src/index.js",
    "prepare": "husky",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run smoke"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "tsx": "^4.23.5",
    "typescript": "~5.9",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
